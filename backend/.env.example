PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/documind?schema=public"

# JWT Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-a-secure-refresh-token-secret-key"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# OpenAI Configuration
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Storage & CORS
CORS_ORIGIN="http://localhost:5173"
MAX_FILE_SIZE_MB=25
